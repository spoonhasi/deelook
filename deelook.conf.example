# deelook 설정 — 이 파일을 deelook.exe 옆에 deelook.conf 라는 이름으로 두면 시작할 때 읽습니다.
# 한 줄에 "이름 = 값". 이름은 명령줄 옵션과 같고(deelook -h 로 목록), 명령줄에 준 값이 이깁니다.
# db, fwlib 의 상대 경로는 이 파일이 있는 폴더 기준입니다. # 뒤는 설명입니다.

# deemesh-hub 주소
hub = http://127.0.0.1:8080

# 웹 서버 주소. ":8090" = 이 PC의 모든 네트워크(다른 PC에서도 접속), "127.0.0.1:8090" = 이 PC에서만
listen = :8090

# HMI 화면에 처음 보여 줄 기계 (machine_id 또는 이름)
# machine = 1

# 조작반 램프를 PMC Y 신호로 읽을 기계 (NC Guide 표준 래더): machine_id=ncguide
# lamps = 1=ncguide

# 수집 데이터 (기본: deelook.exe 옆 deelook-data/sampling.db)
# db = deelook-data/sampling.db

# FOCAS2 라이브러리 (기본: deelook.exe 옆 Fwlib64.dll)
# fwlib = Fwlib64.dll

# 브라우저 자동으로 열기 (기본: 더블클릭으로 실행했을 때만)
# open = false
